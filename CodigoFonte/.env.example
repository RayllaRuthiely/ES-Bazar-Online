# Copie este arquivo para CodigoFonte/.env e preencha com os seus dados.
# O arquivo .env NUNCA deve ser enviado ao GitHub (está no .gitignore).

# Banco de dados MySQL
# Desenvolvimento local: localhost / 3306 / root / sua senha
# Banco compartilhado (Aiven): pedir os dados à Alana, em privado
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=BAZAR_ONLINE

# Chave usada pelo Flask para assinar a sessão e as mensagens flash
SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
